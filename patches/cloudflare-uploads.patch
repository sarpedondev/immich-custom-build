+  async createChunkUpload(auth: AuthDto, dto: AssetChunkUploadCreateDto) {
+    await this.requireAccess({ auth, permission: Permission.AssetUpload, ids: [auth.user.id] });
+    this.requireQuota(auth, dto.fileSize);
+
+    if (!mimeTypes.isAsset(dto.filename)) {
+      throw new BadRequestException(`Unsupported file type ${dto.filename}`);
+    }
+
+    const id = randomUUID();
+    const folder = this.getChunkUploadFolder(auth.user.id, id);
+    this.storageRepository.mkdirSync(folder);
+    const session: ChunkUploadSession = {
+      id,
+      ownerId: auth.user.id,
+      filename: dto.filename,
+      fileSize: dto.fileSize,
+      chunkCount: Math.ceil(dto.fileSize / CHUNK_SIZE),
+      createdAt: new Date().toISOString(),
+      dto: {
+        ...dto,
+        fileCreatedAt: dto.fileCreatedAt.toISOString(),
+        fileModifiedAt: dto.fileModifiedAt.toISOString(),
+      },
+    };
+    await this.storageRepository.createFile(join(folder, 'session.json'), Buffer.from(JSON.stringify(session)));
+    return { id, chunkSize: CHUNK_SIZE, chunkCount: session.chunkCount };
+  }
