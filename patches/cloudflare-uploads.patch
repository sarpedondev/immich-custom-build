+  async completeChunkUpload(auth: AuthDto, id: string): Promise<AssetMediaResponseDto> {
+    const session = await this.getChunkUploadSession(auth, id);
+    const sessionFolder = this.getChunkUploadFolder(auth.user.id, id);
+    for (let index = 0; index < session.chunkCount; index++) {
+      const expectedSize = index === session.chunkCount - 1 ? session.fileSize - index * CHUNK_SIZE : CHUNK_SIZE;
+      try {
+        const stat = await this.storageRepository.stat(join(sessionFolder, `chunk-${index}`));
+        if (stat.size !== expectedSize) {
+          throw new BadRequestException(`Invalid chunk ${index}`);
+        }
+      } catch (error) {
+        if (error instanceof BadRequestException) {
