+  async uploadChunk(auth: AuthDto, id: string, index: number, input: NodeJS.ReadableStream): Promise<void> {
+    const session = await this.getChunkUploadSession(auth, id);
+    if (index < 0 || index >= session.chunkCount) {
+      throw new BadRequestException('Invalid chunk index');
+    }
+
+    const expectedSize = index === session.chunkCount - 1 ? session.fileSize - index * CHUNK_SIZE : CHUNK_SIZE;
+    const folder = this.getChunkUploadFolder(auth.user.id, id);
+    const chunkPath = join(folder, `chunk-${index}`);
+    let received = 0;
+    const limiter = new Transform({
+      transform(chunk: Buffer, _encoding, callback) {
+        received += chunk.length;
+        callback(received > expectedSize ? new BadRequestException('Chunk is larger than expected') : null, chunk);
+      },
+    });
+
+    try {
+      await pipeline(input, limiter, this.storageRepository.createWriteStream(chunkPath));
+      if (received !== expectedSize) {
+        throw new BadRequestException(`Invalid chunk size: expected ${expectedSize}, received ${received}`);
+      }
+    } catch (error) {
+      await this.storageRepository.unlink(chunkPath);
+      throw error;
+    }
+  }
