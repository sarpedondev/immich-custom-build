+  private async getChunkUploadSession(auth: AuthDto, id: string): Promise<ChunkUploadSession> {
+    const metadataPath = join(this.getChunkUploadFolder(auth.user.id, id), 'session.json');
+    try {
+      const session = await this.storageRepository.readJsonFile<ChunkUploadSession>(metadataPath);
+      if (session.ownerId !== auth.user.id) {
+        throw new NotFoundException('Upload session not found');
+      }
+      return session;
+    } catch (error) {
+      if (error instanceof NotFoundException) {
+        throw error;
+      }
+      throw new NotFoundException('Upload session not found');
+    }
+  }
